{
  "scopeName": "source.vtt",
  "name": "WebVTT",
  "fileTypes": [
    "vtt"
  ],
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#blockKeyword"
    },
    {
      "include": "#timestamp"
    },
    {
      "include": "#cueIdentifier"
    },
    {
      "include": "#tag"
    }
  ],
  "repository": {
    "header": {
      "match": "^\\s*(WEBVTT)\\b(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.header.vtt"
        },
        "2": {
          "name": "comment.line.header.vtt"
        }
      }
    },
    "blockKeyword": {
      "match": "^\\s*(NOTE|STYLE|REGION)\\b.*$",
      "captures": {
        "1": {
          "name": "keyword.control.block.vtt"
        }
      }
    },
    "timestamp": {
      "match": "^\\s*((?:\\d+:)?\\d{1,2}:\\d{2}\\.\\d{3})\\s*(-->)\\s*((?:\\d+:)?\\d{1,2}:\\d{2}\\.\\d{3})\\s*(.*)$",
      "captures": {
        "1": {
          "name": "constant.numeric.timestamp.vtt"
        },
        "2": {
          "name": "keyword.operator.arrow.vtt"
        },
        "3": {
          "name": "constant.numeric.timestamp.vtt"
        },
        "4": {
          "name": "string.unquoted.settings.vtt"
        }
      }
    },
    "cueIdentifier": {
      "match": "^\\s*([A-Za-z0-9_-]+)\\s*$",
      "captures": {
        "1": {
          "name": "entity.name.function.cue.vtt"
        }
      }
    },
    "tag": {
      "patterns": [
        {
          "match": "</?(?:c|v|lang|ruby|rt|b|i|u)(?:\\.[^\\s>]+|\\s+[^>]*)?>",
          "name": "entity.name.tag.vtt"
        }
      ]
    }
  }
}
