{
  "scopeName": "source.ass",
  "name": "Advanced SubStation Alpha",
  "fileTypes": [
    "ass",
    "ssa"
  ],
  "patterns": [
    {
      "include": "#section"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#eventKeyword"
    },
    {
      "include": "#keyValue"
    },
    {
      "include": "#timestamp"
    },
    {
      "include": "#overrideBlock"
    }
  ],
  "repository": {
    "section": {
      "match": "^\\s*(\\[(?:Script Info|V4\\+? Styles|Events|Fonts|Graphics)\\])\\s*$",
      "captures": {
        "1": {
          "name": "entity.name.section.ass"
        }
      }
    },
    "comment": {
      "match": "^\\s*(;).*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.ass"
        }
      },
      "name": "comment.line.semicolon.ass"
    },
    "eventKeyword": {
      "match": "^\\s*(Dialogue|Comment|Picture|Sound|Movie|Command)\\s*(:)",
      "captures": {
        "1": {
          "name": "keyword.control.event.ass"
        },
        "2": {
          "name": "punctuation.separator.key-value.ass"
        }
      }
    },
    "keyValue": {
      "match": "^\\s*([A-Za-z][A-Za-z0-9 _-]*?)\\s*(:)",
      "captures": {
        "1": {
          "name": "support.type.property.ass"
        },
        "2": {
          "name": "punctuation.separator.key-value.ass"
        }
      }
    },
    "timestamp": {
      "match": "\\b\\d+:\\d{2}:\\d{2}\\.\\d{2}\\b",
      "name": "constant.numeric.timestamp.ass"
    },
    "overrideBlock": {
      "match": "\\{[^}\\n]*\\}",
      "name": "punctuation.definition.override.ass"
    }
  }
}
