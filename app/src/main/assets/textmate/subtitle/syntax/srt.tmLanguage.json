{
  "scopeName": "source.srt",
  "name": "SubRip Subtitle",
  "fileTypes": [
    "srt"
  ],
  "patterns": [
    {
      "include": "#cueNumber"
    },
    {
      "include": "#timestamp"
    },
    {
      "include": "#htmlTag"
    },
    {
      "include": "#overrideTag"
    }
  ],
  "repository": {
    "cueNumber": {
      "match": "^\\s*(\\d+)\\s*$",
      "captures": {
        "1": {
          "name": "constant.numeric.cue-number.srt"
        }
      }
    },
    "timestamp": {
      "match": "^\\s*(\\d{1,3}:\\d{2}:\\d{2}[,.]\\d{1,3})\\s*(-->)\\s*(\\d{1,3}:\\d{2}:\\d{2}[,.]\\d{1,3})\\s*(.*)$",
      "captures": {
        "1": {
          "name": "constant.numeric.timestamp.srt"
        },
        "2": {
          "name": "keyword.operator.arrow.srt"
        },
        "3": {
          "name": "constant.numeric.timestamp.srt"
        },
        "4": {
          "name": "string.unquoted.settings.srt"
        }
      }
    },
    "htmlTag": {
      "patterns": [
        {
          "match": "</?(?:i|b|u|s|font)(?:\\s+[^>]*)?>",
          "name": "entity.name.tag.srt"
        }
      ]
    },
    "overrideTag": {
      "match": "\\{\\\\[^}]*\\}",
      "name": "punctuation.definition.override.srt"
    }
  }
}
