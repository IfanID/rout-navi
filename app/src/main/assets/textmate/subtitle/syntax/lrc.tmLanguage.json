{
  "scopeName": "source.lrc",
  "name": "Lyrics (LRC)",
  "fileTypes": [
    "lrc"
  ],
  "patterns": [
    {
      "include": "#metadata"
    },
    {
      "include": "#timestamp"
    },
    {
      "include": "#wordTimestamp"
    }
  ],
  "repository": {
    "metadata": {
      "match": "^\\s*(\\[(?:ar|ti|al|by|offset|length|re|ve|au|tool):)([^\\]]*)(\\])",
      "captures": {
        "1": {
          "name": "support.type.property.lrc"
        },
        "2": {
          "name": "string.unquoted.value.lrc"
        },
        "3": {
          "name": "punctuation.definition.metadata.lrc"
        }
      }
    },
    "timestamp": {
      "match": "\\[(\\d{1,3}):(\\d{2})(?:\\.(\\d{1,3}))?\\]",
      "captures": {
        "1": {
          "name": "constant.numeric.timestamp.minutes.lrc"
        },
        "2": {
          "name": "constant.numeric.timestamp.seconds.lrc"
        },
        "3": {
          "name": "constant.numeric.timestamp.fraction.lrc"
        }
      }
    },
    "wordTimestamp": {
      "match": "<\\d{1,3}:\\d{2}(?:\\.\\d{1,3})?>",
      "name": "constant.numeric.timestamp.word.lrc"
    }
  }
}
